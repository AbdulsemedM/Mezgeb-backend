{
  "description": "RFC 8785 canonical JSON. input_json is parsed with a standard JSON parser, then canonicalized; the result must equal canonical exactly (UTF-8).",
  "cases": [
    { "name": "key order", "input_json": "{\"b\":2,\"a\":1}", "canonical": "{\"a\":1,\"b\":2}" },
    {
      "name": "nested objects and arrays keep array order",
      "input_json": "{ \"z\": { \"y\": 1, \"x\": [3, { \"b\": 1, \"a\": 2 }] } }",
      "canonical": "{\"z\":{\"x\":[3,{\"a\":2,\"b\":1}],\"y\":1}}"
    },
    {
      "name": "keys sort by UTF-16 code units, not code points",
      "input_json": "{\"\\ufb01\":5,\"\\ud83d\\ude00\":4,\"\\u20ac\":3,\"\\u00e9\":2,\"a\":1}",
      "canonical": "{\"a\":1,\"é\":2,\"€\":3,\"😀\":4,\"ﬁ\":5}"
    },
    {
      "name": "string escapes",
      "input_json": "{\"s\":\"line\\nquote\\\"back\\\\slash\\ttab\\u0001ctl\\u001f\"}",
      "canonical": "{\"s\":\"line\\nquote\\\"back\\\\slash\\ttab\\u0001ctl\\u001f\"}"
    },
    {
      "name": "non-ASCII stays literal, slash is not escaped",
      "input_json": "{\"shop\":\"\\u1218\\u12dd\\u1308\\u1265 a/b\"}",
      "canonical": "{\"shop\":\"መዝገብ a/b\"}"
    },
    {
      "name": "integers including the largest safe integer and negatives",
      "input_json": "[0,-0,1,-150,12500,9007199254740991,-9007199254740991]",
      "canonical": "[0,0,1,-150,12500,9007199254740991,-9007199254740991]"
    },
    {
      "name": "ECMAScript number formatting",
      "input_json": "[1e21,1e-7,123.456,0.1,100,1E2,4.50]",
      "canonical": "[1e+21,1e-7,123.456,0.1,100,100,4.5]"
    },
    {
      "name": "literals and empties",
      "input_json": "{\"t\":true,\"f\":false,\"n\":null,\"o\":{},\"a\":[]}",
      "canonical": "{\"a\":[],\"f\":false,\"n\":null,\"o\":{},\"t\":true}"
    },
    {
      "name": "whitespace removed",
      "input_json": " { \"a\" : [ 1 , 2 ] , \"b\" : \"x y\" } ",
      "canonical": "{\"a\":[1,2],\"b\":\"x y\"}"
    }
  ]
}
