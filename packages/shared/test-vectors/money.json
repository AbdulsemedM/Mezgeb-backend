{
  "description": "Money helpers (ADR-007). All amounts in integer santim; qty is canonical decimal text.",
  "parse_birr": [
    { "input": "0", "santim": 0 },
    { "input": "12", "santim": 1200 },
    { "input": "12.5", "santim": 1250 },
    { "input": "12.50", "santim": 1250 },
    { "input": "0.05", "santim": 5 },
    { "input": "1,234.50", "santim": 123450 },
    { "input": "1,000,000", "santim": 100000000 },
    { "input": " 40 ", "santim": 4000 }
  ],
  "parse_birr_invalid": ["", "12.345", "-1", "1.2.3", "abc", "1,23", "12,", ".5", "1 000"],
  "line_amount": [
    { "unit_price": 3000, "qty": "1.5", "amount": 4500, "note": "exact" },
    { "unit_price": 1500, "qty": "6", "amount": 9000 },
    { "unit_price": 100, "qty": "0.333", "amount": 33, "note": "33.3 rounds down" },
    { "unit_price": 100, "qty": "0.335", "amount": 34, "note": "33.5 rounds half up" },
    { "unit_price": 99, "qty": "0.5", "amount": 50, "note": "49.5 rounds half up" },
    { "unit_price": 12345, "qty": "0.001", "amount": 12, "note": "12.345" },
    { "unit_price": 0, "qty": "3", "amount": 0 },
    { "unit_price": 4000, "qty": "0", "amount": 0 }
  ],
  "normalize_qty": [
    { "input": "1.50", "qty": "1.5" },
    { "input": "02", "qty": "2" },
    { "input": "0.0", "qty": "0" },
    { "input": "10", "qty": "10" },
    { "input": "007.250", "qty": "7.25" }
  ],
  "format_birr": [
    { "santim": 123450, "language": "en", "text": "ETB 1,234.50" },
    { "santim": 123450, "language": "om", "text": "ETB 1,234.50" },
    { "santim": 123450, "language": "am", "text": "1,234.50 ብር" },
    { "santim": 5, "language": "en", "text": "ETB 0.05" },
    { "santim": -500, "language": "en", "text": "ETB -5.00" },
    { "santim": 100000000, "language": "am", "text": "1,000,000.00 ብር" }
  ]
}
