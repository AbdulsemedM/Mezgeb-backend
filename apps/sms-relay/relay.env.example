# Mezgeb SMS relay settings (ADR-018). Copy to relay.env next to relay.mjs; chmod 600.
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=
SMS_QUEUE_KEY=mezgeb:sms
COOPBANK_SMS_CLIENT_ID=
COOPBANK_SMS_CLIENT_SECRET=
# Defaults are the UAT gateway; set the production URLs in production.
# COOPBANK_SMS_TOKEN_URL=
# COOPBANK_SMS_SEND_URL=
# Drop messages older than this many seconds.
SMS_MAX_AGE_S=3600
