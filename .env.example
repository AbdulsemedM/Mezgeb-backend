NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgres://mezgeb:mezgeb@localhost:55432/mezgeb
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mezgeb-dev
S3_ACCESS_KEY=mezgeb
S3_SECRET_KEY=mezgeb-dev-secret
# Dev-only secrets; production values come from the secret store (>= 32 chars each).
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
OTP_PEPPER=dev-only-otp-pepper-change-me-0123456789
TRUST_PROXY=false
PUBLIC_WEB_URL=http://localhost:5173
OUTBOX_POLL_MS=2000
# Dev-only /v1/dev routes (mobile integration test reads the last OTP). Never in production.
DEV_ROUTES=true

# M10 notifications (ADR-015): push off until a Firebase project exists; SMS caps per plan.
PUSH_PROVIDER=none
SMS_CAP_FREE=300
SMS_CAP_SHOP=1500
SMS_CAP_SHOP_PLUS=5000
REMINDERS_INTERVAL_MS=3600000
